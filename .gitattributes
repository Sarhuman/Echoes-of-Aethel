* text=auto

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.sh text eol=lf

*.png binary
*.wav binary
*.ogg binary
*.mp3 binary

# New 3D modeling concepts only; existing concept PNGs retain their Git history.
docs/media/concepts/model-sheets/*.png filter=lfs diff=lfs merge=lfs -text

client/unreal/Content/**/*.uasset filter=lfs diff=lfs merge=lfs -text
client/unreal/Content/**/*.umap filter=lfs diff=lfs merge=lfs -text
client/unreal/SourceArt/** filter=lfs diff=lfs merge=lfs -text

# Unity-generated YAML contains intentional empty scalar values with trailing spaces.
client/unity/Assets/*.meta text eol=lf -whitespace
client/unity/Assets/**/*.meta text eol=lf -whitespace
client/unity/Assets/**/*.unity text eol=lf -whitespace
client/unity/ProjectSettings/*.asset text eol=lf -whitespace
