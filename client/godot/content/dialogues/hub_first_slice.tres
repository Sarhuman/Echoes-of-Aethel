[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://content/dialogues/dialogue_definition.gd" id="1"]
[resource]
script = ExtResource("1")
lines = Array[Dictionary]([{"line_id":"hub.bram.stage0.base","npc_id":"npc.blacksmith","speaker":"Bram • Ferreiro","requires":[],"text":"Aço ruim mente no primeiro golpe. O meu avisa antes de quebrar. Se trouxer uma arma de volta, traga também a história dela."},{"line_id":"hub.lyra.stage0.base","npc_id":"npc.alchemist","speaker":"Lyra • Alquimista","requires":[],"text":"Uma cura precisa funcionar amanhã também. Se eu lhe prometer mais do que isso, peça para ver minhas anotações."},{"line_id":"hub.elder.stage0.base","npc_id":"npc.elder","speaker":"Irian • Conselho","requires":[],"text":"Uma cidade não começa no portão. Começa quando alguém decide guardar o nome de quem ainda está lá fora."},{"line_id":"hub.maera.stage0.base","npc_id":"npc.gatekeeper","speaker":"Maera • Guarda","requires":[],"text":"Há gente desaparecendo no Bosque. Traga nomes. Estamos cansados de contar sombras."},{"line_id":"hub.sera.stage0.base","npc_id":"npc.merchant","speaker":"Sera • Abastecimento","requires":[],"text":"Posso contar sacos. Pessoas não cabem tão bem nas contas."},{"line_id":"hub.bram.stage1.mercy","npc_id":"npc.blacksmith","speaker":"Bram • Ferreiro","requires":["hub.contamination_observed"],"text":"O aprendiz dorme aqui. Diz que escuta a água mesmo longe do poço. Eu bato o martelo mais baixo."},{"line_id":"hub.lyra.water_distribution","npc_id":"npc.alchemist","speaker":"Lyra • Alquimista","requires":["hub.contamination_observed"],"text":"Isolei o poço. A distribuição de água limpa continua aqui. Não vou deixar a próxima família beber o que ainda não compreendemos."},{"line_id":"hub.elder.stage1.shelter","npc_id":"npc.elder","speaker":"Irian • Conselho","requires":["hub.shelter_observed"],"text":"Recebemos famílias inteiras. Hoje vou escrever seus nomes antes que alguém comece a chamar todos de problema."},{"line_id":"hub.maera.shelter_observed","npc_id":"npc.gatekeeper","speaker":"Maera • Guarda","requires":["hub.shelter_observed"],"text":"As famílias estão abrigadas. A guarda protege os portões; Lyra cuida da água."},{"line_id":"hub.sera.stage1.mercy","npc_id":"npc.merchant","speaker":"Sera • Abastecimento","requires":["hub.shelter_observed"],"text":"Abrimos espaço para os que vieram. Ninguém perguntou ao estoque."},{"line_id":"hub.bram.stage1.judgment","npc_id":"npc.blacksmith","speaker":"Bram • Ferreiro","requires":["hub.memorial_observed"],"text":"Vieram lâminas sem dono. Pediram que eu apagasse os nomes. Quem não tem nome nunca pode dizer que foi inocente."},{"line_id":"hub.lyra.stage1.judgment","npc_id":"npc.alchemist","speaker":"Lyra • Alquimista","requires":["hub.memorial_observed"],"text":"Tenho remédios sobrando. Isso nunca foi boa notícia."},{"line_id":"hub.elder.stage1.loss","npc_id":"npc.elder","speaker":"Irian • Conselho","requires":["hub.memorial_observed"],"text":"Trouxeram a notícia de que a estrada está segura. Pedi os nomes. Disseram que isso atrasaria a próxima escolta."},{"line_id":"hub.maera.memorial_observed","npc_id":"npc.gatekeeper","speaker":"Maera • Guarda","requires":["hub.memorial_observed"],"text":"Os parentes pedem listas. Alguns atravessam a praça só para não passar por mim."},{"line_id":"hub.sera.stage1.judgment","npc_id":"npc.merchant","speaker":"Sera • Abastecimento","requires":["hub.memorial_observed"],"text":"Estas botas têm nome por dentro. Vou guardar até alguém vir buscá-las."}])
